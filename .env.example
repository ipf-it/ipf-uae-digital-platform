# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# After the first schema, also run server/migrations/002_event_directory.sql
# for event category / emirate / start-date filters.
# Used once to seed the first Supabase Auth super-admin account.
IPF_ADMIN_EMAIL=admin@example.com
IPF_ADMIN_PASSWORD=change-this-to-at-least-12-characters
IPF_ADMIN_SEED_PASSWORD_PREFIX=use-a-private-prefix
IPF_ADMIN_SEED_PASSWORD_SUFFIX=use-a-private-suffix

# Also run server/migrations/002_event_directory.sql, 003_identity_rbac_workflow.sql,
# 003_supabase_auth.sql, 004_scoped_event_workflow.sql, and 005_scale_indexes.sql (all idempotent,
# already folded into schema.sql — only needed if bootstrapping a fresh database from schema.sql
# predates them).

# Authorizes Vercel Cron to call /api/cron/purge-audit-logs (Vercel sends this automatically as a
# Bearer token once set as a project env var — see vercel.json's `crons` entry).
CRON_SECRET=generate-a-long-random-string

# Rate limiting (Upstash Redis — https://console.upstash.com, free tier is enough to start).
# Public write endpoints (registration, inquiries, donations) run unthrottled until both are set.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Phone OTP delivery for member/Yuva registration (MSG91 — https://msg91.com). Without these, the
# verification code is logged to the server console instead of texted — fine for local testing,
# not for production.
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=your-approved-sender-id
MSG91_OTP_TEMPLATE_ID=your-msg91-otp-template-id
